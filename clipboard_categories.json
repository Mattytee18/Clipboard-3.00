name: Build apps

# Runs on every push to main, on demand (Actions tab → "Build apps" → Run workflow),
# and on version tags. Pushing a tag like v1.0.0 also publishes a GitHub Release
# with the Windows .exe and the Mac .zip attached.
on:
  push:
    branches: [main]
    tags: ["v*"]
  workflow_dispatch:

permissions:
  contents: write   # needed to create releases on tag pushes

jobs:
  windows:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt pyinstaller

      - name: Build .exe
        run: >
          pyinstaller --noconfirm --clean --onefile --windowed
          --name "Clipboard Manager"
          --icon icon.ico
          --add-data "icon.ico;."
          --add-data "icon.png;."
          --collect-data customtkinter
          windows.pyw

      - uses: actions/upload-artifact@v4
        with:
          name: ClipboardManager-windows
          path: dist/Clipboard Manager.exe

  mac:
    strategy:
      fail-fast: false
      matrix:
        include:
          - runner: macos-latest       # Apple Silicon (M1/M2/M3/M4)
            arch: apple-silicon
          - runner: macos-15-intel     # Intel Macs
            arch: intel
    runs-on: ${{ matrix.runner }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt pyinstaller

      - name: Build .app
        run: >
          pyinstaller --noconfirm --clean --windowed
          --name "Clipboard Manager"
          --icon icon.icns
          --osx-bundle-identifier com.clipboardmanager.app
          --add-data "icon.png:."
          --add-data "clipboard_items.json:."
          --add-data "clipboard_categories.json:."
          --collect-data customtkinter
          mac.py

      - name: Zip the app
        run: ditto -c -k --keepParent "dist/Clipboard Manager.app" "ClipboardManager-mac-${{ matrix.arch }}.zip"

      - uses: actions/upload-artifact@v4
        with:
          name: ClipboardManager-mac-${{ matrix.arch }}
          path: ClipboardManager-mac-${{ matrix.arch }}.zip

  release:
    if: startsWith(github.ref, 'refs/tags/v')
    needs: [windows, mac]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/download-artifact@v4
        with:
          path: artifacts
          merge-multiple: true

      - uses: softprops/action-gh-release@v2
        with:
          files: artifacts/*
